{
  "name": "localstream",
  "version": "1.0.0",
  "description": "LocalStream - Self-Hosted LAN Video Streaming & Host PC Remote Control",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev:server": "ts-node src/server/index.ts",
    "dev:client": "vite",
    "dev:electron": "electron .",
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,VITE\" -c \"blue.bold,cyan.bold\" \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:client && npm run build:server && npm run build:electron",
    "start": "node dist-server/server/index.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:portable": "npm run build && electron-builder --win portable",
    "dist:nsis": "npm run build && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.localstream.app",
    "productName": "LocalStream",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "prisma/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/@prisma/client/**/*",
      "**/node_modules/.prisma/**/*",
      "**/node_modules/@ffmpeg-installer/**/*",
      "**/node_modules/@ffprobe-installer/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LocalStream"
    }
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "chokidar": "^3.6.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "fluent-ffmpeg": "^2.1.3",
    "framer-motion": "^11.11.11",
    "hls.js": "^1.5.17",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.454.0",
    "mime-types": "^2.1.35",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "systeminformation": "^5.23.5",
    "tailwind-merge": "^2.5.4",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/fluent-ffmpeg": "^2.1.26",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^20.17.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^33.0.2",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.47",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
